# Threadmark local development environment.
# Copy to `.env` (which is gitignored) before running `pnpm infra:up`:
#   cp .env.example .env
#
# These are LOCAL DEVELOPMENT credentials only. Never use them in any shared or
# production environment.

# ── App Postgres (system of record, pgvector) ────────────────────────────────
POSTGRES_USER=threadmark
POSTGRES_PASSWORD=threadmark_local_dev
POSTGRES_DB=threadmark
POSTGRES_PORT=5432

# Connection string used by Drizzle (migrations, app). Must match the values above.
DATABASE_URL=postgres://threadmark:threadmark_local_dev@localhost:5432/threadmark

# ── Temporal's dedicated Postgres (isolated from the app DB) ──────────────────
TEMPORAL_POSTGRES_USER=temporal
TEMPORAL_POSTGRES_PASSWORD=temporal_local_dev

# ── Temporal ─────────────────────────────────────────────────────────────────
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233

# ── OpenSearch (lexical / BM25 index) ────────────────────────────────────────
OPENSEARCH_PORT=9200

# ── Redis (cache) ────────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MinIO (S3-compatible blob store for uploaded evidence) ───────────────────
MINIO_ROOT_USER=threadmark
MINIO_ROOT_PASSWORD=threadmark_local_dev
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Jaeger (local trace viewer) ───────────────────────────────────────────────
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318

# ── Telemetry (OpenTelemetry traces) ─────────────────────────────────────────
# Points at the Jaeger container brought up by `pnpm infra:up`. View traces at
# http://localhost:16686. Leave unset (or comment out) to disable tracing
# entirely — no exporter is constructed and no network calls are made.
#
# NOT auto-derived from JAEGER_OTLP_HTTP_PORT above: Node's `--env-file` loader
# (used by every `node --env-file=.env ...` script here) has no variable
# expansion, so this URL's port is a plain literal. If you change
# JAEGER_OTLP_HTTP_PORT to resolve a local port collision, you MUST also
# update the port in this URL to match, or tracing will silently target the
# wrong port.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ── Agent model provider (packages/agent) ────────────────────────────────────
# Set exactly one to run the cited-Q&A agent. If both are set, Anthropic wins.
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GENERATIVE_AI_API_KEY=...
#
# Optional overrides of the default model id per provider:
# AGENT_ANTHROPIC_MODEL_ID=claude-sonnet-5
# AGENT_GOOGLE_MODEL_ID=gemini-2.5-flash
