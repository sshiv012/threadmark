{
  "name": "threadmark",
  "version": "0.0.0",
  "private": true,
  "description": "Threadmark — collaborative, evidence-backed PRD workspace",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "infra:smoke": "bash infra/docker/smoke.sh",
    "worker": "pnpm --filter @threadmark/worker... build && node --env-file=.env apps/worker/dist/worker.js",
    "ingest": "pnpm --filter @threadmark/worker... build && node --env-file=.env apps/worker/dist/cli/ingest.js",
    "seed": "pnpm --filter @threadmark/worker... build && node --env-file=.env apps/worker/dist/cli/seed.js",
    "eval:seed": "pnpm --filter @threadmark/worker... build && node --env-file=.env apps/worker/dist/cli/eval-seed.js",
    "retrieve": "pnpm --filter @threadmark/worker... build && node --env-file=.env apps/worker/dist/cli/retrieve.js",
    "test:dogfood": "pnpm --filter @threadmark/worker test:dogfood",
    "test:eval": "pnpm --filter @threadmark/worker test:eval"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
